$accent: #63f3ff;
$bg-base: #0b1016;
$bg-hover: #1e2a36;
$text-primary: #d7dde8;
$text-dim: #8d98a7;
$border-muted: #3d4f63;

* {
    scrollbar-size: 0 0;
}

Screen {
    background: $bg-base;
    color: $text-primary;
}

#root {
    height: 1fr;
}

#chrome {
    layout: horizontal;
    height: auto;
    padding: 0 1;
}

.app-title {
    color: $accent;
    text-style: bold;
    padding: 0 1;
    width: auto;
}

#view-tabs {
    width: 1fr;
    margin: 0 1;
}

#view-tabs > .-active {
    color: $accent;
    text-style: bold;
}

#view-tabs > .-hidden {
    display: none;
}

#reload-status {
    width: auto;
    height: 1;
    padding: 0 1;
}

.reload-chip {
    width: auto;
    height: 1;
    padding: 0;
    color: $text-dim;
}

.reload-chip:hover,
.status-meta-chip:hover {
    color: $accent;
}

#hover-tip {
    layer: overlay;
    display: none;
    width: auto;
    height: auto;
    min-width: 28;
    max-width: 58;
    padding: 0 1;
    background: #121820;
    color: $text-dim;
}

#reload-cache,
#reload-api {
    margin-left: 1;
}

#status-tray {
    width: auto;
    height: 1;
    padding: 0 1;
    content-align: right middle;
    color: $text-dim;
}

#status-message-inline {
    width: auto;
    height: 1;
    padding: 0 1 0 0;
}

.status-meta-chip {
    width: auto;
    height: 1;
    padding: 0 0 0 1;
}

#bottom-bar {
    dock: bottom;
    height: 1;
    width: 1fr;
    background: $bg-base;
}

#bottom-bar Footer {
    dock: none;
    width: 1fr;
    height: 1;
}

#main {
    height: 1fr;
}

#content {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

.view {
    display: none;
    height: 1fr;
}

.view.-active {
    display: block;
}

/* ── Smooth focus border transitions ─────────────────── */
DataTable {
    height: 1fr;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

DataTable:focus,
DataTable:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

DataTable:focus > .datatable--cursor,
DataTable:focus-within > .datatable--cursor {
    background: $bg-hover;
    color: $accent;
    text-style: bold;
}

DataTable:focus > .datatable--fixed-cursor,
DataTable:focus-within > .datatable--fixed-cursor {
    background: $bg-hover;
    color: $accent;
}

DataTable > .datatable--cursor {
    background: $bg-hover;
    color: $text-primary;
}

DataTable > .datatable--fixed-cursor {
    background: $bg-hover;
}

DataTable > .datatable--header {
    background: $bg-base;
    color: $accent;
    text-style: bold;
}

#overview-recovery-table,
#overview-recovery-table:focus,
#overview-recovery-table:focus-within {
    border: none;
}
#overview-recent-log-table,
#overview-recent-log-table:focus,
#overview-recent-log-table:focus-within {
    border: none;
}

#spark-rail {
    width: 34;
    min-width: 34;
    max-width: 34;
    border: none;
    padding: 0;
    display: none;
}

#spark-weeks-table {
    height: 1fr;
    min-height: 0;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

#spark-weeks-table:focus,
#spark-weeks-table:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

#spark-weeks-table > .datatable--header {
    background: $bg-base;
    color: $accent;
    text-style: bold;
}

#spark-days-table {
    height: auto;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

#spark-days-table:focus,
#spark-days-table:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

#spark-catchup {
    height: auto;
    border: round $border-muted;
    padding: 0 1;
    background: $bg-base;
}

#spark-catchup:focus,
#spark-catchup:focus-within {
    border: round #fab387;
    background: $bg-base;
    background-tint: transparent 0%;
}

/* ── Buttons ───────────────────────────────────────── */
Button {
    background: $bg-base;
    border: none;
    min-width: 4;
    height: 1;
}

Button:hover {
    color: $accent;
    background: $bg-hover;
}

/* ── Footer ────────────────────────────────────────── */
Footer {
    height: 1;
    background: $bg-base;
    color: $text-dim;
}

Footer > FooterKey .footer-key--key {
    color: #e2b714;
}

Footer > FooterKey .footer-key--description {
    color: $text-dim;
}

/* ── OptionList ─────────────────────────────────────── */
OptionList {
    background: $bg-base;
    color: $text-primary;
    border: none;
    height: auto;
    max-height: 10;
}

OptionList > .option-list--option {
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #27323d;
    color: $accent;
}

