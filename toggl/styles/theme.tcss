$accent: #63f3ff;
$bg-base: #0b1016;
$bg-hover: #1e2a36;
$text-primary: #d7dde8;
$text-dim: #8d98a7;
$border-muted: #3d4f63;

* {
    scrollbar-size: 0 0;
}

Screen {
    background: $bg-base;
    color: $text-primary;
}

/* ── Splash screen (startup loading) ─────────────────── */
SplashScreen {
    background: $bg-base;
    align: center middle;
}

#splash-container {
    width: auto;
    height: auto;
    border: round $border-muted;
    padding: 2 4;
    background: $bg-base;
    align: center middle;
}

#splash-logo {
    color: $accent;
    text-style: bold;
    text-align: center;
    width: auto;
}

#splash-loading {
    color: $text-dim;
    text-align: center;
    width: auto;
    margin-top: 1;
}

#root {
    height: 1fr;
}

#chrome {
    layout: horizontal;
    height: auto;
    padding: 0 1;
}

.app-title {
    color: $accent;
    text-style: bold;
    padding: 0 1;
    width: auto;
}

#view-tabs {
    width: 1fr;
    margin: 0 1;
}

#view-tabs > .-active {
    color: $accent;
    text-style: bold;
}

#view-tabs > .-hidden {
    display: none;
}

#sync-status {
    width: auto;
    padding: 0 1;
}

#sync-status.sync-fresh {
    color: #37d994;
}
#sync-status.sync-warn {
    color: #e2b714;
}
#sync-status.sync-stale {
    color: #ff5f5f;
}

#main {
    height: 1fr;
}

#content {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

.view {
    display: none;
    height: 1fr;
}

.view.-active {
    display: block;
}

/* ── Smooth focus border transitions ─────────────────── */
DataTable {
    height: 1fr;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

DataTable:focus,
DataTable:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

DataTable:focus > .datatable--cursor,
DataTable:focus-within > .datatable--cursor {
    background: $bg-hover;
    color: $accent;
    text-style: bold;
}

DataTable:focus > .datatable--fixed-cursor,
DataTable:focus-within > .datatable--fixed-cursor {
    background: $bg-hover;
    color: $accent;
}

DataTable > .datatable--cursor {
    background: $bg-hover;
    color: $text-primary;
}

DataTable > .datatable--fixed-cursor {
    background: $bg-hover;
}

DataTable > .datatable--header {
    background: $bg-base;
    color: $accent;
    text-style: bold;
}

#overview-recovery-table,
#overview-recovery-table:focus,
#overview-recovery-table:focus-within {
    border: none;
}
#overview-recent-log-table,
#overview-recent-log-table:focus,
#overview-recent-log-table:focus-within {
    border: none;
}

#spark-rail {
    width: 34;
    min-width: 34;
    max-width: 34;
    border: none;
    padding: 0;
    display: none;
}

#spark-weeks-table {
    height: 1fr;
    min-height: 0;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

#spark-weeks-table:focus,
#spark-weeks-table:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

#spark-weeks-table > .datatable--header {
    background: $bg-base;
    color: $accent;
    text-style: bold;
}

#spark-days-table {
    height: auto;
    border: round $border-muted;
    background: $bg-base;
    color: $text-primary;
}

#spark-days-table:focus,
#spark-days-table:focus-within {
    border: round $accent;
    background: $bg-base;
    background-tint: transparent 0%;
}

#spark-catchup {
    height: auto;
    border: round $border-muted;
    padding: 0 1;
    background: $bg-base;
}

#spark-catchup:focus,
#spark-catchup:focus-within {
    border: round #fab387;
    background: $bg-base;
    background-tint: transparent 0%;
}

/* ── Buttons ───────────────────────────────────────── */
Button {
    background: $bg-base;
    border: none;
    min-width: 4;
    height: 1;
}

Button:hover {
    color: $accent;
    background: $bg-hover;
}

/* ── Footer ────────────────────────────────────────── */
Footer {
    background: $bg-base;
    color: $text-dim;
}

Footer > FooterKey .footer-key--key {
    color: #e2b714;
}

Footer > FooterKey .footer-key--description {
    color: $text-dim;
}

/* ── OptionList ─────────────────────────────────────── */
OptionList {
    background: $bg-base;
    color: $text-primary;
    border: none;
    height: auto;
    max-height: 10;
}

OptionList > .option-list--option {
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #27323d;
    color: $accent;
}

/* ── Toast notifications with icons ─────────────────── */
Toast {
    background: $bg-base;
    color: $text-primary;
    border: round $border-muted;
    padding: 0 1;
    margin: 1 1 0 0;
    height: auto;
}
Toast.-information {
    border: round #37d994;
}
Toast.-warning {
    border: round #e2b714;
}
Toast.-error {
    border: round #ff5f5f;
}
